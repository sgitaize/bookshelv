# Kopieren nach .env.deploy (wird nicht eingecheckt) und ausfüllen.
# Ziel: Shared Hosting mit Plesk + Node.js (z. B. netcup Webhosting) per SSH.
# Nur von diesem Rechner (Ausgabe von `hostname`) darf deployt werden
DEPLOY_FROM_HOST=my-build-box
DEPLOY_HOST=example.netcup.net
DEPLOY_USER=hosting12345
# Empfohlen: SSH-Key (hat Vorrang). Sonst Passwort per sshpass.
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_PASSWORD=
# App-Ordner relativ zum Home-Verzeichnis (= "Application Root" in Plesk)
DEPLOY_APP_DIR=bookshelv.example.org/app
