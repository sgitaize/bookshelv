<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sicherung der lokalen Bibliothek in die iCloud der Person (iCloud Drive → bookshelv) -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.de.sgitaize.bookshelv</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.de.sgitaize.bookshelv</string>
	</array>
	<!-- Passwort-AutoFill: Zugangsdaten von bookshelv.aize-it.de (/.well-known/apple-app-site-association) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:bookshelv.aize-it.de</string>
	</array>
</dict>
</plist>
